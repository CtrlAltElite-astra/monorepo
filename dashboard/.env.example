VITE_REGIONS=mum=http://127.0.0.1:8001,pun=http://127.0.0.1:8002
VITE_API_KEY=dev-officer
# Set to 1 to run the UI without any backend (uses contracts/fixtures, read-only)
VITE_FIXTURES=0

# TRUE credential login (needs scripts/true_stack.py up, regions started with AUTH_ENABLED=true).
# With VITE_AUTH_ENABLED=1 the UI never sends an API key: it signs in with a TRUE credential.
VITE_AUTH_ENABLED=0
VITE_ISSUER_URL=http://127.0.0.1:4001
