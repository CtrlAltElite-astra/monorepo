{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "packages",
    "services",
    "scripts",
    "tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
