VITE_MODE=live
VITE_REGION_URLS=mum=/api/mum,pun=/api/pun,del=/api/del,blr=/api/blr
VITE_CHAOS_URL=/chaos
VITE_OFFICER_KEY=dev-officer
VITE_SUPERVISOR_KEY=dev-supervisor
VITE_ADMIN_KEY=dev-admin
# One API key per shopper (optional). Each key must also be listed in the region's API_KEYS, with its own actor, so the
# per-shopper limit counts Bob and Alice separately. Without this every shopper uses the officer key and shares one allowance.
# VITE_SHOPPER_KEYS=Alice=dev-alice,Bob=dev-bob,Chitra=dev-chitra,Dev=dev-dev,Esha=dev-esha
# Show the adults-only item even when the backend is not in sign-in mode (it is refused there: API-key mode has no claims).
# In sign-in mode it is always shown. ?restricted=1 in the URL does the same.
# VITE_RESTRICTED_PRODUCT=1
#
# Sign-in mode (the partner credential): needs `npm install` in ../collaboration/true and a backend started with AUTH_ENABLED=true.
# VITE_AUTH_ENABLED=1
# VITE_ISSUER_URL=/issuer          # claim codes are redeemed here (proxied to ISSUER_BACKEND_URL)
# VITE_RELAY_URL=/relay            # the revoke button (python scripts/true_stack.py relay)
MUM_BACKEND_URL=http://127.0.0.1:8001
PUN_BACKEND_URL=http://127.0.0.1:8002
DEL_BACKEND_URL=http://127.0.0.1:8003
BLR_BACKEND_URL=http://127.0.0.1:8004
CHAOS_BACKEND_URL=http://127.0.0.1:9000
ISSUER_BACKEND_URL=http://127.0.0.1:4001
RELAY_BACKEND_URL=http://127.0.0.1:4090
