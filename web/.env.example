# Copy to web/.env (git-ignored). Every line is optional: the defaults below already match scripts/run_regions.py.

# mock = the in-browser simulator of three nodes (no backend needed); live = the real regions.
# The address bar overrides this: /demo?mode=live, /demo?mode=mock, /demo?nodes=2 (start with Delhi not joined).
VITE_MODE=mock

# The real regions, as id=url pairs.
VITE_REGION_URLS=mum=http://127.0.0.1:8001,pun=http://127.0.0.1:8002,del=http://127.0.0.1:8003

# The chaos agent (scripts/chaos_agent.py): lets the console kill and start nodes. Dev only.
VITE_CHAOS_URL=http://127.0.0.1:9000

# DEVELOPMENT keys only (scripts/run_one.py provisions these on every region). They are visible to the browser:
# never reuse them for anything real.
VITE_OFFICER_KEY=dev-officer
VITE_SUPERVISOR_KEY=dev-supervisor
VITE_ADMIN_KEY=dev-admin
