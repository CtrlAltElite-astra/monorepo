# Copy to .env only if you want to run one region by hand.
# scripts/run_regions.py sets all of this for you.
REGION=mum
PORT=8001
DB_PATH=data/mum.db
# Basic build runs two regions. Add del=http://127.0.0.1:8003 in Phase 3 (Delhi).
PEERS=pun=http://127.0.0.1:8002
PEER_TOKEN=change-me
# format: key:actor:role[,key:actor:role]
API_KEYS=dev-officer:officer-mum-1:officer
ADMIN_KEY=dev-admin
SYNC_INTERVAL_MS=1000
PAGE_SIZE=200
HTTP_TIMEOUT_S=1.0
ENABLE_ADMIN=1
PUSH_ENABLED=1
LINK_RATE_BPS=0
LINK_SLOW_BPS=10000
WRITE_BATCH_MS=0
WRITE_QUEUE_MAX=100
ENABLE_CARRY=1
CHAOS_PORT=9000

# --- Scaling, rate limiting (contract v1.2). All OFF by default; change them live with POST /admin/config. ----
# Per-shopper token bucket (read by region/api/ratelimit.py): burst 0 = off, refill is requests per second.
RATE_ACTOR_BURST=0
RATE_ACTOR_REFILL_PER_S=1
# Whole-region write limit in writes per second; over it a write gets 503 overloaded + Retry-After. 0 = off.
REGION_WRITE_LIMIT_PER_S=0
# Writes saved per transaction: low 1, medium 8, high 32 (group commit; only batches writes already waiting).
POWER=medium
# Regions in the port table: mum 8001, pun 8002, del 8003, blr 8004 (Bengaluru, not started by default).
# To let the chaos agent start Bengaluru, run it with REGIONS=mum,pun,del,blr.

# --- Optional: TRUE credential sessions (SyncShield sign-in). OFF unless AUTH_ENABLED=true. ---------------------
# Easiest: `python scripts/true_stack.py up --provision`, then start each region with
#   AUTH_ENABLED=true python scripts/run_one.py mum      (scripts/run_one.py fills in the values below)
# or print them for a region: `python scripts/true_stack.py env mum`. In this mode only
# `Authorization: Bearer <session>` is accepted; X-API-Key is ignored. Needs `pip install -r requirements-auth.txt`.
# The dashboard must be served from an allowed origin (default :5173 / :4173); for another port set
# CORS_ORIGINS=http://localhost:5199 (comma separated).
# AUTH_ENABLED=true
# AUTH_SIDECAR_URL=http://127.0.0.1:4101
# AUTH_SIDECAR_TOKEN=            # printed by `true_stack.py env`; never commit it
# TRUE_ISSUER_PUBLIC_JWK_FILE=data/true/pinned/issuer-public.json
# AUTH_SESSION_KEY_DIR=data/true/pinned/session-keys
# AUTH_STATUS_FILE=data/true/status/mum.jws
